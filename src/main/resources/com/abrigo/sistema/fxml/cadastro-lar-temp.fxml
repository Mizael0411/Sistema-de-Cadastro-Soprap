<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true"
            styleClass="cadastro-scroll"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.abrigo.controller.CadastroLarTempController">

    <stylesheets>
        <URL value="@../../css/style.css"/>
    </stylesheets>

    <content>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              styleClass="cadastro-pagina">

            <padding>
                <Insets top="30" right="20" bottom="40" left="20"/>
            </padding>

            <VBox maxWidth="780"
                  spacing="24"
                  styleClass="cadastro-card">

                <padding>
                    <Insets top="32" right="34" bottom="30" left="34"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="16">

                    <StackPane prefWidth="56"
                               prefHeight="56"
                               minWidth="56"
                               styleClass="cadastro-icone">

                        <ImageView fitWidth="34"
                                   fitHeight="34"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../../images/abrigo.png"/>
                            </image>
                        </ImageView>
                    </StackPane>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">

                        <Label text="SOPRAP  ·  ACOLHIMENTO"
                               styleClass="cadastro-sobretitulo"/>

                        <Label text="Cadastro de Lar Temporário"
                               styleClass="cadastro-titulo"
                               wrapText="true"/>

                        <Label text="Cadastre o responsável e a estrutura disponível para acolher os animais."
                               styleClass="cadastro-subtitulo"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <Separator styleClass="cadastro-separador"/>

                <VBox spacing="5">
                    <Label text="01  ·  Dados do responsável"
                           styleClass="cadastro-secao-titulo"/>

                    <Label text="Identificação e contato do lar voluntário."
                           styleClass="cadastro-secao-subtitulo"/>
                </VBox>

                <GridPane hgap="18" vgap="17">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="7"
                          GridPane.columnIndex="0"
                          GridPane.columnSpan="2"
                          GridPane.rowIndex="0">

                        <Label text="NOME DO RESPONSÁVEL *"
                               styleClass="cadastro-rotulo"/>

                        <TextField fx:id="txtNome"
                                   maxWidth="Infinity"
                                   promptText="Nome completo do responsável"
                                   styleClass="input-campo"/>
                    </VBox>

                    <VBox spacing="7"
                          GridPane.columnIndex="0"
                          GridPane.columnSpan="2"
                          GridPane.rowIndex="1">

                        <Label text="ENDEREÇO COMPLETO *"
                               styleClass="cadastro-rotulo"/>

                        <TextField fx:id="txtEndereco"
                                   maxWidth="Infinity"
                                   promptText="Rua, número, bairro e cidade"
                                   styleClass="input-campo"/>
                    </VBox>

                    <VBox spacing="7"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="2">

                        <Label text="TELEFONE / WHATSAPP *"
                               styleClass="cadastro-rotulo"/>

                        <TextField fx:id="txtTelefone"
                                   maxWidth="Infinity"
                                   promptText="(XX) 9XXXX-XXXX"
                                   styleClass="input-campo"/>
                    </VBox>

                    <VBox spacing="7"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2">

                        <Label text="CAPACIDADE TOTAL *"
                               styleClass="cadastro-rotulo"/>

                        <Spinner fx:id="spCapacidade"
                                 editable="true"
                                 initialValue="0"
                                 min="0"
                                 max="100"
                                 maxWidth="Infinity"
                                 styleClass="input-campo"/>
                    </VBox>
                </GridPane>

                <Separator styleClass="cadastro-separador"/>

                <VBox spacing="5">
                    <Label text="02  ·  Estrutura e acolhimento"
                           styleClass="cadastro-secao-titulo"/>

                    <Label text="Informe as vagas e as condições de acolhimento."
                           styleClass="cadastro-secao-subtitulo"/>
                </VBox>

                <GridPane hgap="18" vgap="17">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="7"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="0">

                        <Label text="VAGAS DISPONÍVEIS *"
                               styleClass="cadastro-rotulo"/>

                        <Spinner fx:id="spDisponibilidadeVagas"
                                 editable="true"
                                 initialValue="0"
                                 min="0"
                                 max="100"
                                 maxWidth="Infinity"
                                 styleClass="input-campo"/>

                        <Label fx:id="lblAvisoVagas"
                               managed="false"
                               visible="false"
                               styleClass="aviso-vagas"
                               wrapText="true"/>
                    </VBox>

                    <VBox spacing="7"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0">

                        <Label text="ACEITA DOENÇAS TRANSMISSÍVEIS? *"
                               styleClass="cadastro-rotulo"
                               wrapText="true"/>

                        <ComboBox fx:id="cbAceitaDoencas"
                                  maxWidth="Infinity"
                                  promptText="Selecione uma opção"
                                  styleClass="input-campo">

                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Sim"/>
                                    <String fx:value="Não"/>
                                    <String fx:value="Não se aplica"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>

                    <VBox spacing="7"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1">

                        <Label text="ACEITA ANIMAIS COM DEFICIÊNCIA? *"
                               styleClass="cadastro-rotulo"
                               wrapText="true"/>

                        <ComboBox fx:id="cbAceitaDeficiencia"
                                  maxWidth="Infinity"
                                  promptText="Selecione uma opção"
                                  styleClass="input-campo">

                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Sim"/>
                                    <String fx:value="Não"/>
                                    <String fx:value="Não se aplica"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>
                </GridPane>

                <Separator styleClass="cadastro-separador"/>

                <HBox alignment="CENTER_RIGHT"
                      spacing="10">

                    <padding>
                        <Insets top="5"/>
                    </padding>

                    <Button fx:id="btnLimpar"
                            onAction="#limparCampos"
                            styleClass="btn-acao, btn-voltar"
                            text="Limpar campos"/>

                    <Button fx:id="btnVerHistorico"
                            onAction="#verHistorico"
                            styleClass="btn-acao, btn-historico"
                            text="Ver histórico"/>

                    <Button fx:id="btnSalvar"
                            onAction="#salvar"
                            styleClass="btn-acao, btn-novo"
                            text="Salvar lar temporário"/>
                </HBox>

            </VBox>
        </VBox>
    </content>
</ScrollPane>
