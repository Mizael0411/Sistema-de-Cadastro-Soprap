<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="15" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.abrigo.view.CadastroAnimalController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Cadastro de Animal">
        <font>
            <Font size="20"/>
        </font>
    </Label>

    <GridPane hgap="10" vgap="12">

        <!-- Nome -->
        <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNome" promptText="Nome do animal"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- Idade -->
        <Label text="Idade:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtIdade" promptText="Idade em anos"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Sexo -->
        <Label text="Sexo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbSexo" promptText="Selecione"  onAction="#atualizarStatusGravidez"
                  GridPane.rowIndex="2" GridPane.columnIndex="1">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Macho"/>
                    <String fx:value="Fêmea"/>
                </FXCollections>
            </items>
        </ComboBox>

        <!-- Data de nascimento -->
        <Label text="Data de Nascimento:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpDataNascimento"
                    GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- Status de gravidez -->
        <Label text="Status de Gravidez:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbGravida" promptText="Selecione"
                  GridPane.rowIndex="4" GridPane.columnIndex="1">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Não grávida"/>
                    <String fx:value="Grávida"/>
                    <String fx:value="Não se aplica"/>
                </FXCollections>
            </items>
        </ComboBox>

        <!-- Status de vacinação -->
        <Label text="Status de Vacinação:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbVacina" promptText="Selecione"
                  GridPane.rowIndex="5" GridPane.columnIndex="1">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Vacinado"/>
                    <String fx:value="Não vacinado"/>
                    <String fx:value="Não se aplica"/>
                </FXCollections>
            </items>
        </ComboBox>

        <!-- Data última consulta -->
        <Label text="Data Última Consulta:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpUltimaConsulta"
                    GridPane.rowIndex="6" GridPane.columnIndex="1"/>

    </GridPane>

    <HBox spacing="10">
        <Button fx:id="btnSalvar" text="Salvar" onAction="#salvar"/>
        <Button fx:id="btnLimpar" text="Limpar" onAction="#limpar"/>
    </HBox>

</VBox>
