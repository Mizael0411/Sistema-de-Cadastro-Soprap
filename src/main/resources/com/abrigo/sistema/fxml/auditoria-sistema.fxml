<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20"
      style="-fx-background-color: #FAF8F5;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.abrigo.controller.AuditoriaController">

    <stylesheets>
        <URL value="@../../css/style.css"/>
    </stylesheets>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <StackPane prefHeight="50"
                   prefWidth="50"
                   style="-fx-background-color: #FCE4EC;
                          -fx-background-radius: 12;">
            <ImageView fitWidth="30" fitHeight="30"
                       preserveRatio="true">
                <image>
                    <Image url="@../../images/auditória.png"/>
                </image>
            </ImageView>
        </StackPane>

        <VBox spacing="3">
            <Label text="Auditoria do Sistema"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2C3E50;"/>

            <Label text="Acompanhe o histórico de operações realizadas no sistema."
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #7F8C8D;"/>
        </VBox>
    </HBox>

    <VBox spacing="14"
          style="-fx-background-color: #FFFFFF;
                 -fx-background-radius: 16;
                 -fx-border-color: #F1E5D1;
                 -fx-border-radius: 16;
                 -fx-border-width: 1.5;">

        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Filtrar registros"
               style="-fx-font-size: 16px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #2C3E50;"/>

        <HBox spacing="12" alignment="CENTER_LEFT">

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Usuário"
                       style="-fx-text-fill: #475569;
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>

                <ComboBox fx:id="cbUsuario"
                          promptText="Todos os usuários"
                          maxWidth="Infinity"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 9;
                                 -fx-border-color: #E2D3BC;
                                 -fx-border-radius: 9;
                                 -fx-pref-height: 38;"
                          HBox.hgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Operação"
                       style="-fx-text-fill: #475569;
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>

                <ComboBox fx:id="cbOperacao"
                          promptText="Todas as operações"
                          maxWidth="Infinity"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 9;
                                 -fx-border-color: #E2D3BC;
                                 -fx-border-radius: 9;
                                 -fx-pref-height: 38;"
                          HBox.hgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Módulo"
                       style="-fx-text-fill: #475569;
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>

                <ComboBox fx:id="cbModulo"
                          promptText="Todos os módulos"
                          maxWidth="Infinity"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 9;
                                 -fx-border-color: #E2D3BC;
                                 -fx-border-radius: 9;
                                 -fx-pref-height: 38;"
                          HBox.hgrow="ALWAYS"/>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_RIGHT">
            <Button text="Limpar filtros"
                    onAction="#limparFiltros"
                    styleClass="btn-acao, btn-voltar"/>
        </HBox>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Registros de auditoria"
                   style="-fx-font-size: 17px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2C3E50;"/>

            <Label text="Consulte o histórico das atividades registradas no sistema."
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #7F8C8D;"/>
        </VBox>
    </HBox>

    <VBox style="-fx-background-color: #FFFFFF;
                 -fx-background-radius: 16;
                 -fx-border-color: #F1E5D1;
                 -fx-border-radius: 16;
                 -fx-border-width: 1.5;"
          VBox.vgrow="ALWAYS">

        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>

        <TableView fx:id="tabelaAuditoria"
                   style="-fx-background-color: transparent;
                          -fx-border-color: transparent;"
                   VBox.vgrow="ALWAYS">

            <placeholder>
                <Label text="Nenhum registro de auditoria encontrado."
                       style="-fx-text-fill: #7F8C8D;
                              -fx-font-size: 13px;"/>
            </placeholder>

            <columns>
                <TableColumn fx:id="colId"
                             text="ID"
                             prefWidth="50"/>

                <TableColumn fx:id="colDataHora"
                             text="Data e hora"
                             prefWidth="135"/>

                <TableColumn fx:id="colUsuario"
                             text="Usuário"
                             prefWidth="125"/>

                <TableColumn fx:id="colOperacao"
                             text="Operação"
                             prefWidth="105"/>

                <TableColumn fx:id="colModulo"
                             text="Módulo"
                             prefWidth="100"/>

                <TableColumn fx:id="colRegistro"
                             text="ID do registro"
                             prefWidth="100"/>

                <TableColumn fx:id="colDescricao"
                             text="Descrição"
                             prefWidth="280"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Label fx:id="lblQuantidade"
               text="0 registro(s)"
               style="-fx-font-size: 12px;
                      -fx-text-fill: #7F8C8D;"
               HBox.hgrow="ALWAYS"/>
    </HBox>

</VBox>