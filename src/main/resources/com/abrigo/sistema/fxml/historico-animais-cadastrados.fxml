<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #FAF8F5;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.abrigo.controller.HistoricoAnimaisCadastradosController">

    <stylesheets>
        <URL value="@../../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <!-- Cabeçalho -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <StackPane prefHeight="50" prefWidth="50"
                   style="-fx-background-color: #FFF3E0; -fx-background-radius: 12;">
            <Label style="-fx-font-size: 24px;" text="📋" />
        </StackPane>
        <VBox spacing="3">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                   text="Animais Cadastrados" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;"
                   text="Gerencie os resgatados do abrigo." />
        </VBox>
    </HBox>

    <!-- Barra de pesquisa + Botões -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="txtBusca"
                   promptText="🔍  Buscar por nome ou ID..."
                   HBox.hgrow="ALWAYS"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0;
                          -fx-border-radius: 10; -fx-background-radius: 10;
                          -fx-padding: 10 14; -fx-font-size: 13px;" />

        <Button onAction="#inserir" styleClass="btn-acao, btn-novo" text="+ Novo Animal" />
        <Button onAction="#editar" styleClass="btn-acao, btn-editar" text="Editar" />
        <Button onAction="#excluir" styleClass="btn-acao, btn-excluir" text="Excluir" />
    </HBox>

    <!-- Tabela -->
    <VBox VBox.vgrow="ALWAYS"
          style="-fx-background-color: #FFFFFF; -fx-background-radius: 16;
                 -fx-border-color: #F1E5D1; -fx-border-radius: 16; -fx-border-width: 1.5;">
        <padding>
            <Insets bottom="15" left="15" right="15" top="15" />
        </padding>

        <TableView fx:id="tabelaAnimais" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <columns>
                <TableColumn fx:id="colunaIdAnimal"           prefWidth="60"  text="ID" />
                <TableColumn fx:id="colunaNomeAnimal"         prefWidth="160" text="Nome" />
                <TableColumn fx:id="colunaEspecie"            prefWidth="100" text="Espécie" />
                <TableColumn fx:id="colunaPorte"              prefWidth="100" text="Porte" />
                <TableColumn fx:id="colunaIdadeAnimal"        prefWidth="70"  text="Idade" />
                <TableColumn fx:id="colunaSexo"               prefWidth="90"  text="Sexo" />
                <TableColumn fx:id="colunaStsVacinacao"       prefWidth="130" text="Vacinação" />
                <TableColumn fx:id="colunaDataUltimaVacinacao" prefWidth="150" text="Última Vacina" />
                <TableColumn fx:id="colunaStsGravidez"        prefWidth="140" text="Gestação" />
            </columns>
        </TableView>
    </VBox>

    <HBox alignment="CENTER_RIGHT">
        <Button onAction="#voltar" styleClass="btn-acao, btn-voltar" text="Voltar" />
    </HBox>
</VBox>