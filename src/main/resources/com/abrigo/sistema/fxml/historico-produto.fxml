<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #FAF8F5; -fx-background: #FAF8F5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abrigo.controller.HistoricoCadastroProdutoController">
    
    <stylesheets>
        <URL value="@../../css/style.css" />
    </stylesheets>

    <content>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #FAF8F5;">
            <padding>
                <Insets bottom="40" left="20" right="20" top="30" />
            </padding>

            <VBox maxWidth="900" spacing="22" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-border-color: #F1E5D1; -fx-border-radius: 20; -fx-border-width: 1.5; -fx-effect: dropshadow(three-pass-box, rgba(160, 110, 50, 0.08), 16, 0, 0, 6);">
                <padding>
                    <Insets bottom="35" left="35" right="35" top="35" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <StackPane prefHeight="50" prefWidth="50" style="-fx-background-color: #FFF3E0; -fx-background-radius: 12;">
                        <Label style="-fx-font-size: 24px;" text="📋" />
                    </StackPane>

                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Produtos Cadastrados" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;" text="Gerencie o histórico de todos os produtos e insumos adquiridos." />
                    </VBox>
                </HBox>

                <Separator style="-fx-opacity: 0.3;" />

                <TableView fx:id="tabelaProdutos" minHeight="300" style="-fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colNome" prefWidth="250.0" text="Nome" />
                        <TableColumn fx:id="colPrecoCompra" prefWidth="150.0" text="Preço de Compra (R$)" />
                        <TableColumn fx:id="colDataCompra" prefWidth="150.0" text="Data de Compra" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Separator style="-fx-opacity: 0.3;" />

                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <padding>
                        <Insets top="10" />
                    </padding>

                    <Button onAction="#btnVoltarOnAction" styleClass="btn-acao, btn-voltar" text="Voltar" />
                    <Button onAction="#btnExcluirOnAction" styleClass="btn-acao, btn-excluir" text="Excluir" />
                    <Button onAction="#btnEditarOnAction" styleClass="btn-acao, btn-editar" text="Editar" />
                    <Button onAction="#btnNovoProdutoOnAction" styleClass="btn-acao, btn-novo" text="+ Novo Produto" />
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>