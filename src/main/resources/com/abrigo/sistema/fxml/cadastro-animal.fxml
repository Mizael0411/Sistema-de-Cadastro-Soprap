<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="cadastro-scroll"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.abrigo.controller.CadastroAnimalController">

    <stylesheets>
        <URL value="@../../css/style.css"/>
    </stylesheets>

    <content>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              styleClass="cadastro-pagina">

            <padding>
                <Insets top="26" right="22" bottom="34" left="22"/>
            </padding>

            <VBox maxWidth="820"
                  spacing="22"
                  styleClass="cadastro-card">

                <padding>
                    <Insets top="28" right="30" bottom="28" left="30"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="15">

                    <StackPane minWidth="58" minHeight="58"
                               prefWidth="58" prefHeight="58"
                               styleClass="cadastro-icone">
                        <ImageView fitWidth="36" fitHeight="36"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../../images/pets.png"/>
                            </image>
                        </ImageView>
                    </StackPane>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="CUIDADO E ACOLHIMENTO"
                               styleClass="cadastro-sobretitulo"/>
                        <Label text="Cadastro de pet"
                               styleClass="cadastro-titulo"/>
                        <Label text="Registre as informações do animal para acompanhar sua jornada no abrigo."
                               wrapText="true"
                               styleClass="cadastro-subtitulo"/>
                    </VBox>
                </HBox>

                <Separator styleClass="cadastro-separador"/>

                <VBox spacing="14">
                    <VBox spacing="4">
                        <Label text="01  ·  Identificação"
                               styleClass="cadastro-secao-titulo"/>
                        <Label text="Comece pelas informações básicas do animal."
                               styleClass="cadastro-secao-subtitulo"/>
                    </VBox>

                    <GridPane hgap="16" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"
                                               hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50"
                                               hgrow="ALWAYS"/>
                        </columnConstraints>

                        <VBox spacing="7"
                              GridPane.columnIndex="0"
                              GridPane.columnSpan="2"
                              GridPane.rowIndex="0">
                            <Label text="Nome do animal *"
                                   styleClass="cadastro-rotulo"/>
                            <TextField fx:id="txtNome"
                                       promptText="Ex.: Pipoca, Bidu, Thor..."
                                       styleClass="input-campo"
                                       maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="7"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="1">
                            <Label text="Espécie *"
                                   styleClass="cadastro-rotulo"/>
                            <ComboBox fx:id="cbEspecie"
                                      promptText="Selecione a espécie"
                                      maxWidth="Infinity"
                                      styleClass="input-campo"/>
                        </VBox>

                        <VBox spacing="7"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1">
                            <Label text="Porte do animal *"
                                   styleClass="cadastro-rotulo"/>
                            <ComboBox fx:id="cbPorte"
                                      promptText="Selecione o porte"
                                      maxWidth="Infinity"
                                      styleClass="input-campo"/>
                        </VBox>

                        <VBox spacing="7"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="2">
                            <Label text="Sexo *"
                                   styleClass="cadastro-rotulo"/>
                            <ComboBox fx:id="cbSexo"
                                      promptText="Selecione o sexo"
                                      maxWidth="Infinity"
                                      styleClass="input-campo"/>
                        </VBox>

                        <VBox spacing="7"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="2">
                            <Label text="Status gestacional *"
                                   styleClass="cadastro-rotulo"/>
                            <ComboBox fx:id="cbGravida"
                                      promptText="Selecione o status"
                                      maxWidth="Infinity"
                                      styleClass="input-campo"/>
                        </VBox>

                        <VBox spacing="7"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="3">
                            <Label text="Data de nascimento (opcional)"
                                   styleClass="cadastro-rotulo"/>
                            <DatePicker fx:id="dpDataNascimento"
                                        promptText="Se houver registro"
                                        maxWidth="Infinity"
                                        styleClass="input-campo"/>
                        </VBox>

                        <VBox spacing="7"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="3">
                            <Label text="Idade estimada (anos) *"
                                   styleClass="cadastro-rotulo"/>
                            <TextField fx:id="txtIdade"
                                       promptText="Ex.: 2"
                                       styleClass="input-campo"
                                       maxWidth="Infinity"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <Separator styleClass="cadastro-separador"/>

                <VBox spacing="14">
                    <VBox spacing="4">
                        <Label text="02  ·  Saúde"
                               styleClass="cadastro-secao-titulo"/>
                        <Label text="Registre a situação de vacinação e as necessidades especiais."
                               wrapText="true"
                               styleClass="cadastro-secao-subtitulo"/>
                    </VBox>

                    <GridPane hgap="16" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"
                                               hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50"
                                               hgrow="ALWAYS"/>
                        </columnConstraints>

                        <VBox spacing="7"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="0">
                            <Label text="Status de vacinação *"
                                   styleClass="cadastro-rotulo"/>
                            <ComboBox fx:id="cbVacina"
                                      promptText="Selecione o status"
                                      maxWidth="Infinity"
                                      styleClass="input-campo"/>
                        </VBox>

                        <VBox spacing="7"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="0">
                            <Label text="Última consulta"
                                   styleClass="cadastro-rotulo"/>
                            <DatePicker fx:id="dpUltimaConsulta"
                                        promptText="Se houver registro"
                                        maxWidth="Infinity"
                                        styleClass="input-campo"/>
                        </VBox>

                        <VBox spacing="7"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="1">
                            <Label text="Possui deficiência?"
                                   styleClass="cadastro-rotulo"/>
                            <ComboBox fx:id="cbPossuiDeficiencia"
                                      promptText="Selecione uma opção"
                                      maxWidth="Infinity"
                                      styleClass="input-campo"/>
                        </VBox>

                        <VBox spacing="7"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1">
                            <Label text="Descrição da deficiência"
                                   styleClass="cadastro-rotulo"/>
                            <TextField fx:id="txtDescricaoDeficiencia"
                                       promptText="Descreva, se houver"
                                       maxWidth="Infinity"
                                       styleClass="input-campo"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <Separator styleClass="cadastro-separador"/>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button text="Limpar campos"
                            onAction="#limpar"
                            styleClass="btn-acao, btn-voltar"/>

                    <Button text="Ver histórico"
                            onAction="#verHistorico"
                            styleClass="btn-acao, btn-historico"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Salvar animal"
                            onAction="#salvar"
                            styleClass="btn-acao, btn-novo"/>
                </HBox>

            </VBox>
        </VBox>
    </content>
</ScrollPane>
