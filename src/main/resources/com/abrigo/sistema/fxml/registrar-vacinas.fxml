<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            styleClass="cadastro-scroll"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.abrigo.controller.RegistrarVacinasController">

    <stylesheets>
        <URL value="@../../css/style.css"/>
    </stylesheets>

    <content>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              styleClass="cadastro-pagina">

            <padding>
                <Insets top="30" right="20" bottom="40" left="20"/>
            </padding>

            <VBox maxWidth="700"
                  spacing="24"
                  styleClass="cadastro-card">

                <padding>
                    <Insets top="32" right="34" bottom="30" left="34"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="16">

                    <StackPane prefWidth="56"
                               prefHeight="56"
                               minWidth="56"
                               styleClass="cadastro-icone">

                        <ImageView fitWidth="34"
                                   fitHeight="34"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../../images/vacina.png"/>
                            </image>
                        </ImageView>
                    </StackPane>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">

                        <Label text="SOPRAP  ·  CUIDADOS VETERINÁRIOS"
                               styleClass="cadastro-sobretitulo"
                               wrapText="true"/>

                        <Label text="Registrar Vacina"
                               styleClass="cadastro-titulo"
                               wrapText="true"/>

                        <Label text="Registre a aplicação e acompanhe a próxima vacinação do animal."
                               styleClass="cadastro-subtitulo"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <Separator styleClass="cadastro-separador"/>

                <VBox spacing="5">
                    <Label text="01  ·  Identificação"
                           styleClass="cadastro-secao-titulo"/>

                    <Label text="Selecione o animal e informe a vacina aplicada."
                           styleClass="cadastro-secao-subtitulo"
                           wrapText="true"/>
                </VBox>

                <VBox spacing="17">

                    <VBox spacing="7">
                        <Label text="ANIMAL *"
                               styleClass="cadastro-rotulo"/>

                        <ComboBox fx:id="cbAnimal"
                                  maxWidth="Infinity"
                                  promptText="Selecione o animal"
                                  styleClass="input-campo"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label text="NOME / TIPO DA VACINA *"
                               styleClass="cadastro-rotulo"/>

                        <ComboBox fx:id="cbTipoVacina"
                                  maxWidth="Infinity"
                                  promptText="Selecione o tipo de vacina"
                                  styleClass="input-campo"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label text="DOSE *"
                               styleClass="cadastro-rotulo"/>

                        <ComboBox fx:id="cbDose"
                                  maxWidth="Infinity"
                                  promptText="Selecione a dose"
                                  styleClass="input-campo"/>
                    </VBox>

                </VBox>

                <Separator styleClass="cadastro-separador"/>

                <VBox spacing="5">
                    <Label text="02  ·  Datas da vacinação"
                           styleClass="cadastro-secao-titulo"/>

                    <Label text="Informe quando a vacina foi aplicada e, se necessário, a data prevista para a próxima dose."
                           styleClass="cadastro-secao-subtitulo"
                           wrapText="true"/>
                </VBox>

                <VBox spacing="17">

                    <VBox spacing="7">
                        <Label text="DATA DA APLICAÇÃO *"
                               styleClass="cadastro-rotulo"/>

                        <DatePicker fx:id="dpDataVacinacao"
                                    maxWidth="Infinity"
                                    promptText="Selecione a data"
                                    styleClass="input-campo"/>
                    </VBox>

                    <VBox spacing="7">
                        <Label text="PRÓXIMA VACINAÇÃO"
                               styleClass="cadastro-rotulo"/>

                        <DatePicker fx:id="dpDataProximaVacinacao"
                                    maxWidth="Infinity"
                                    promptText="Selecione a próxima data, se aplicável"
                                    styleClass="input-campo"/>
                    </VBox>

                </VBox>

                <Separator styleClass="cadastro-separador"/>

                <HBox alignment="CENTER_RIGHT"
                      spacing="10">

                    <padding>
                        <Insets top="5"/>
                    </padding>

                    <Button onAction="#abrirHistorico"
                            styleClass="btn-acao, btn-voltar"
                            text="Cancelar"/>

                    <Button onAction="#abrirHistorico"
                            styleClass="btn-acao, btn-historico"
                            text="Ver histórico"/>

                    <Button onAction="#salvar"
                            styleClass="btn-acao, btn-salvar"
                            text="Salvar vacina"/>
                </HBox>

            </VBox>
        </VBox>
    </content>
</ScrollPane>
