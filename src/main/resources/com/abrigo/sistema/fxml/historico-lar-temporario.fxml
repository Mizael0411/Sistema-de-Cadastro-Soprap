<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: #FAF8F5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abrigo.controller.HistoricoLarTempController">

    <stylesheets>
        <URL value="@../../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="30" left="30" right="30" top="30" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <StackPane prefHeight="50" prefWidth="50" style="-fx-background-color: #FFF3E0; -fx-background-radius: 12;">
            <Label style="-fx-font-size: 24px;" text="📋" />
        </StackPane>
        <VBox spacing="3">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Histórico de Lares Temporários" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;" text="Consulte, filtre e gerencie os lares temporários cadastrados." />
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 0 12;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #A0A0A0;" text="🔍" />
            <TextField fx:id="txtFiltroNome" onKeyTyped="#filtrar" promptText="Buscar por nome do responsável..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 10 0; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
        </HBox>
        
        <Button onAction="#novoLar" styleClass="btn-acao, btn-novo" text="+ Novo Lar" />
        <Button onAction="#editarLar" styleClass="btn-acao, btn-editar" text="Editar" />
        <Button onAction="#excluirLar" styleClass="btn-acao, btn-excluir" text="Excluir" />
    </HBox>

    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #F1E5D1; -fx-border-radius: 16; -fx-border-width: 1.5;" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="15" left="15" right="15" top="15" />
        </padding>

        <TableView fx:id="tblLares" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colNome" prefWidth="160.0" text="Responsável" />
                <TableColumn fx:id="colEndereco" prefWidth="180.0" text="Endereço" />
                <TableColumn fx:id="colTelefone" prefWidth="110.0" text="Telefone" />
                <TableColumn fx:id="colCapacidade" prefWidth="80.0" text="Capacidade" />
                <TableColumn fx:id="colVagas" prefWidth="70.0" text="Vagas" />
                <TableColumn fx:id="colAceitaDoencas" prefWidth="110.0" text="Aceita Doenças?" />
                <TableColumn fx:id="colAceitaDeficiencia" prefWidth="110.0" text="Aceita Deficiência?" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <HBox alignment="CENTER_RIGHT">
        <Button onAction="#voltar" styleClass="btn-acao, btn-voltar" text="Voltar" />
    </HBox>
</VBox>