<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12"
      style="-fx-background-color: #FAF8F5;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.abrigo.controller.HistoricoLarTempController">

    <stylesheets>
        <URL value="@../../css/style.css"/>
    </stylesheets>

    <padding>
        <Insets top="20" right="20" bottom="15" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">

        <StackPane prefHeight="44"
                   prefWidth="44"
                   minHeight="44"
                   minWidth="44"
                   style="-fx-background-color: #FCE4EC;
                          -fx-background-radius: 12;">

            <ImageView fitHeight="27"
                       fitWidth="27"
                       preserveRatio="true">
                <image>
                    <Image url="@../../images/histórico.png"/>
                </image>
            </ImageView>

        </StackPane>

        <VBox spacing="3">
            <Label text="Lares Temporários Cadastrados"
                   style="-fx-font-size: 19px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2C3E50;"/>

            <Label text="Consulte, filtre e gerencie os lares temporários cadastrados."
                   wrapText="true"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #7F8C8D;"/>
        </VBox>

    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="8">

        <HBox alignment="CENTER_LEFT"
              spacing="8"
              HBox.hgrow="ALWAYS"
              style="-fx-background-color: #FFFFFF;
                     -fx-border-color: #E0E0E0;
                     -fx-border-radius: 9;
                     -fx-background-radius: 9;
                     -fx-padding: 0 10;">

            <Label text="🔍"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #A0A0A0;"/>

            <TextField fx:id="txtFiltroNome"
                       onKeyReleased="#filtrar"
                       promptText="Buscar por nome..."
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: transparent;
                              -fx-border-color: transparent;
                              -fx-padding: 9 0;
                              -fx-font-size: 12px;"/>

        </HBox>

        <Button onAction="#novoLar"
                text="+ Novo"
                styleClass="btn-acao, btn-novo"/>

        <Button onAction="#editarLar"
                text="Editar"
                styleClass="btn-acao, btn-editar"/>

        <Button onAction="#excluirLar"
                text="Excluir"
                styleClass="btn-acao, btn-excluir"/>

    </HBox>

    <HBox spacing="12" VBox.vgrow="ALWAYS">

        <VBox spacing="8"
              minWidth="0"
              HBox.hgrow="ALWAYS"
              style="-fx-background-color: #FFFFFF;
                     -fx-background-radius: 12;
                     -fx-border-color: #F1E5D1;
                     -fx-border-radius: 12;
                     -fx-border-width: 1;">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Lista de lares"
                   style="-fx-font-size: 13px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2C3E50;"/>

            <TableView fx:id="tblLares"
                       minHeight="100"
                       prefHeight="400"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: transparent;
                              -fx-border-color: transparent;">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <columns>
                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="40"/>

                    <TableColumn fx:id="colNome"
                                 text="Responsável"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colTelefone"
                                 text="Telefone"
                                 prefWidth="105"/>

                    <TableColumn fx:id="colVagas"
                                 text="Vagas"
                                 prefWidth="65"/>
                </columns>

            </TableView>

        </VBox>

        <VBox spacing="9"
              prefWidth="285"
              minWidth="250"
              maxWidth="320"
              style="-fx-background-color: #FFFFFF;
                     -fx-background-radius: 12;
                     -fx-border-color: #F1E5D1;
                     -fx-border-radius: 12;
                     -fx-border-width: 1;">

            <padding>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </padding>

            <Label text="Detalhes do lar"
                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2C3E50;"/>

            <Separator/>

            <Label fx:id="lblIdDetalhe"
                   text="Nenhum lar selecionado"
                   wrapText="true"
                   style="-fx-font-size: 11px;
                          -fx-text-fill: #8A8A8A;"/>

            <VBox spacing="3">
                <Label text="Responsável"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #7F8C8D;"/>

                <Label fx:id="lblNomeDetalhe"
                       text="Selecione um lar na tabela"
                       wrapText="true"
                       style="-fx-font-size: 13px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2C3E50;"/>
            </VBox>

            <VBox spacing="3">
                <Label text="Endereço"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #7F8C8D;"/>

                <Label fx:id="lblEnderecoDetalhe"
                       text="—"
                       wrapText="true"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #34495E;"/>
            </VBox>

            <VBox spacing="3">
                <Label text="Telefone"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #7F8C8D;"/>

                <Label fx:id="lblTelefoneDetalhe"
                       text="—"
                       wrapText="true"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #34495E;"/>
            </VBox>

            <Separator/>

            <HBox alignment="CENTER_LEFT" spacing="5">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Capacidade"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #7F8C8D;"/>

                    <Label fx:id="lblCapacidadeDetalhe"
                           text="—"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #2C3E50;"/>
                </VBox>

                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Vagas disponíveis"
                           wrapText="true"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #7F8C8D;"/>

                    <Label fx:id="lblVagasDetalhe"
                           text="—"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #2C3E50;"/>
                </VBox>
            </HBox>

            <Separator/>

            <VBox spacing="5">
                <Label text="Preferências de acolhimento"
                       wrapText="true"
                       style="-fx-font-size: 12px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2C3E50;"/>

                <Label fx:id="lblDoencasDetalhe"
                       text="Doenças transmissíveis: —"
                       wrapText="true"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #34495E;"/>

                <Label fx:id="lblDeficienciaDetalhe"
                       text="Animais com deficiência: —"
                       wrapText="true"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #34495E;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

        </VBox>

    </HBox>

    <HBox alignment="CENTER_RIGHT"
          minHeight="35"
          spacing="8">

        <Region HBox.hgrow="ALWAYS"/>

        <Button onAction="#voltar"
                text="Voltar"
                styleClass="btn-acao, btn-voltar"/>

    </HBox>

</VBox>
