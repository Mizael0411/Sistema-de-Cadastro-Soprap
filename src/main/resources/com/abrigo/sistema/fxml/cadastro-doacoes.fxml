<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            styleClass="cadastro-scroll"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.abrigo.controller.CadastroDoacaoController">

    <stylesheets>
        <URL value="@../../css/style.css"/>
    </stylesheets>

    <content>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              styleClass="cadastro-pagina">

            <padding>
                <Insets top="30" right="20" bottom="40" left="20"/>
            </padding>

            <VBox maxWidth="800"
                  spacing="24"
                  styleClass="cadastro-card">

                <padding>
                    <Insets top="32" right="34" bottom="30" left="34"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="16">

                    <StackPane prefWidth="56"
                               prefHeight="56"
                               minWidth="56"
                               styleClass="cadastro-icone">

                        <ImageView fitWidth="34"
                                   fitHeight="34"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../../images/doação.png"/>
                            </image>
                        </ImageView>
                    </StackPane>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">

                        <Label text="SOPRAP  ·  SOLIDARIEDADE"
                               styleClass="cadastro-sobretitulo"/>

                        <Label text="Cadastro de Doação"
                               styleClass="cadastro-titulo"
                               wrapText="true"/>

                        <Label text="Registre as doações financeiras ou de materiais recebidas pelo abrigo."
                               styleClass="cadastro-subtitulo"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <Separator styleClass="cadastro-separador"/>

                <VBox spacing="5">
                    <Label text="01  ·  Identificação da doação"
                           styleClass="cadastro-secao-titulo"/>

                    <Label text="Informe quem realizou a doação, o tipo e a data de recebimento."
                           styleClass="cadastro-secao-subtitulo"
                           wrapText="true"/>
                </VBox>

                <GridPane hgap="18" vgap="17">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="7"
                          GridPane.columnIndex="0"
                          GridPane.columnSpan="2"
                          GridPane.rowIndex="0">

                        <Label text="NOME DO DOADOR *"
                               styleClass="cadastro-rotulo"/>

                        <TextField fx:id="txtNomeDoador"
                                   promptText="Ex.: João Silva ou Anônimo"
                                   maxWidth="Infinity"
                                   styleClass="input-campo"/>
                    </VBox>

                    <VBox spacing="7"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1">

                        <Label text="TIPO DE DOAÇÃO *"
                               styleClass="cadastro-rotulo"/>

                        <ComboBox fx:id="cbTipoDoacao"
                                  promptText="Selecione o tipo"
                                  maxWidth="Infinity"
                                  onAction="#handleTipoChange"
                                  styleClass="input-campo"/>
                    </VBox>

                    <VBox spacing="7"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1">

                        <Label text="DATA DA DOAÇÃO *"
                               styleClass="cadastro-rotulo"/>

                        <DatePicker fx:id="dpDataDoacao"
                                    maxWidth="Infinity"
                                    promptText="Selecione a data"
                                    styleClass="input-campo"/>
                    </VBox>

                    <VBox fx:id="boxValor"
                          spacing="7"
                          visible="false"
                          managed="false"
                          GridPane.columnIndex="0"
                          GridPane.columnSpan="2"
                          GridPane.rowIndex="2">

                        <Label text="VALOR (R$) *"
                               styleClass="cadastro-rotulo"/>

                        <TextField fx:id="txtValor"
                                   promptText="Ex.: 150,00"
                                   maxWidth="Infinity"
                                   styleClass="input-campo"/>
                    </VBox>

                    <VBox fx:id="boxDescricao"
                          spacing="7"
                          GridPane.columnIndex="0"
                          GridPane.columnSpan="2"
                          GridPane.rowIndex="3">

                        <Label fx:id="lblDescricao"
                               text="OBSERVAÇÃO / DESCRIÇÃO (OPCIONAL)"
                               styleClass="cadastro-rotulo"
                               wrapText="true"/>

                        <TextArea fx:id="txtDescricao"
                                  promptText="Adicione informações sobre a doação, se necessário."
                                  prefRowCount="3"
                                  wrapText="true"
                                  maxWidth="Infinity"
                                  styleClass="input-campo"/>
                    </VBox>

                </GridPane>

                <Separator styleClass="cadastro-separador"/>

                <VBox fx:id="boxItens"
                      spacing="14"
                      visible="false"
                      managed="false">

                    <VBox spacing="5">
                        <Label text="02  ·  Itens da doação"
                               styleClass="cadastro-secao-titulo"/>

                        <Label text="Adicione cada material recebido separadamente. A validade é opcional."
                               styleClass="cadastro-secao-subtitulo"
                               wrapText="true"/>
                    </VBox>

                    <Separator styleClass="cadastro-separador"/>

                    <VBox fx:id="listaItens" spacing="10"/>

                    <Button text="+ Adicionar item"
                            onAction="#adicionarItem"
                            maxWidth="Infinity"
                            styleClass="btn-acao, btn-voltar"/>
                </VBox>

                <Separator styleClass="cadastro-separador"/>

                <HBox alignment="CENTER_RIGHT"
                      spacing="10">

                    <padding>
                        <Insets top="5"/>
                    </padding>

                    <Button text="Limpar campos"
                            onAction="#limpar"
                            styleClass="btn-acao, btn-voltar"/>

                    <Button text="Ver histórico"
                            onAction="#verHistorico"
                            styleClass="btn-acao, btn-historico"/>

                    <Button text="Salvar doação"
                            onAction="#salvar"
                            styleClass="btn-acao, btn-salvar"/>
                </HBox>
                
            </VBox>
        </VBox>
    </content>
</ScrollPane>
