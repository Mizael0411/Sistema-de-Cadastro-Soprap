<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20"
      style="-fx-background-color: #FAF8F5;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.abrigo.controller.GestaoUsuariosController">

    <stylesheets>
        <URL value="@../../css/style.css"/>
    </stylesheets>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <StackPane prefHeight="50"
                   prefWidth="50"
                   style="-fx-background-color: #FCE4EC;
                          -fx-background-radius: 12;">
            <ImageView fitWidth="30" fitHeight="30"
                       preserveRatio="true">
                <image>
                    <Image url="@../../images/equipe.png"/>
                </image>
            </ImageView>
        </StackPane>

        <VBox spacing="3">
            <Label text="Gerenciamento de Usuários"
                   style="-fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2C3E50;"/>

            <Label text="Cadastre funcionários e gerencie os acessos ao sistema."
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #7F8C8D;"/>
        </VBox>
    </HBox>

    <VBox spacing="14"
          style="-fx-background-color: #FFFFFF;
                 -fx-background-radius: 16;
                 -fx-border-color: #F1E5D1;
                 -fx-border-radius: 16;
                 -fx-border-width: 1.5;">

        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Cadastrar funcionário"
               style="-fx-font-size: 16px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #2C3E50;"/>

        <HBox spacing="12" alignment="CENTER_LEFT">

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Nome completo"
                       style="-fx-text-fill: #475569;
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>

                <TextField fx:id="txtNome"
                           promptText="Digite o nome completo"
                           maxWidth="Infinity"
                           style="-fx-background-color: white;
                                  -fx-background-radius: 9;
                                  -fx-border-color: #E2D3BC;
                                  -fx-border-radius: 9;
                                  -fx-pref-height: 38;"
                           HBox.hgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Nome de usuário"
                       style="-fx-text-fill: #475569;
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>

                <TextField fx:id="txtNomeUsuario"
                           promptText="Crie um nome de usuário"
                           maxWidth="Infinity"
                           style="-fx-background-color: white;
                                  -fx-background-radius: 9;
                                  -fx-border-color: #E2D3BC;
                                  -fx-border-radius: 9;
                                  -fx-pref-height: 38;"
                           HBox.hgrow="ALWAYS"/>
            </VBox>

            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Senha"
                       style="-fx-text-fill: #475569;
                              -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>

                <HBox alignment="CENTER_RIGHT"
                      style="-fx-background-color: white;
                             -fx-background-radius: 9;
                             -fx-border-color: #E2D3BC;
                             -fx-border-radius: 9;
                             -fx-pref-height: 38;">

                    <StackPane HBox.hgrow="ALWAYS">

                        <PasswordField fx:id="txtSenha"
                                       promptText="Mínimo de 8 caracteres"
                                       maxWidth="Infinity"
                                       style="-fx-background-color: transparent;
                                              -fx-border-width: 0;
                                              -fx-padding: 8;
                                              -fx-font-size: 12px;"/>

                        <TextField fx:id="txtSenhaVisivel"
                                   promptText="Mínimo de 8 caracteres"
                                   visible="false"
                                   managed="false"
                                   maxWidth="Infinity"
                                   style="-fx-background-color: transparent;
                                          -fx-border-width: 0;
                                          -fx-padding: 8;
                                          -fx-font-size: 12px;"/>
                    </StackPane>

                    <ToggleButton fx:id="btnToggleSenha"
                                  onAction="#alternarVisibilidadeSenha"
                                  focusTraversable="false"
                                  accessibleText="Mostrar ou ocultar senha"
                                  style="-fx-background-color: transparent;
                                         -fx-cursor: hand;
                                         -fx-padding: 0 8 0 0;">
                        <graphic>
                            <ImageView fx:id="imgIconeSenha"
                                       fitWidth="22"
                                       fitHeight="22"
                                       preserveRatio="true"
                                       smooth="true"/>
                        </graphic>
                    </ToggleButton>
                </HBox>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="btnCadastrar"
                    text="+ Cadastrar funcionário"
                    onAction="#cadastrarFuncionario"
                    styleClass="btn-acao, btn-novo"/>
        </HBox>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Usuários cadastrados"
                   style="-fx-font-size: 17px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #2C3E50;"/>

            <Label text="Consulte as contas e verifique quais estão ativas."
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #7F8C8D;"/>
        </VBox>
        
    </HBox>

    <VBox style="-fx-background-color: #FFFFFF;
                 -fx-background-radius: 16;
                 -fx-border-color: #F1E5D1;
                 -fx-border-radius: 16;
                 -fx-border-width: 1.5;"
          VBox.vgrow="ALWAYS">

        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>

        <TableView fx:id="tabelaUsuarios"
                   style="-fx-background-color: transparent;
                          -fx-border-color: transparent;"
                   VBox.vgrow="ALWAYS">

            <placeholder>
                <Label text="Nenhum usuário encontrado."
                       style="-fx-text-fill: #7F8C8D;
                              -fx-font-size: 13px;"/>
            </placeholder>

            <columns>
                <TableColumn fx:id="colNome"
                             text="Nome completo"
                             prefWidth="220"/>

                <TableColumn fx:id="colNomeUsuario"
                             text="Nome de usuário"
                             prefWidth="170"/>

                <TableColumn fx:id="colPerfil"
                             text="Perfil"
                             prefWidth="150"/>

                <TableColumn fx:id="colAtivo"
                             text="Situação"
                             prefWidth="120"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Label text="Selecione um funcionário para desativar a conta."
               style="-fx-font-size: 12px;
                      -fx-text-fill: #7F8C8D;"
               HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnDesativar"
                text="Desativar usuário"
                onAction="#desativarSelecionado"
                styleClass="btn-acao, btn-excluir"/>
    </HBox>

</VBox>