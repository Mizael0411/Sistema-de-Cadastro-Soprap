<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>

<StackPane style="-fx-background-color: #FAF8F5;" 
           xmlns="http://javafx.com/javafx/17.0.12" 
           xmlns:fx="http://javafx.com/fxml/1">

    <Pane mouseTransparent="true">
        <Label style="-fx-font-size: 30px; -fx-opacity: 0.15; -fx-rotate: -20;" text="🐾" layoutX="120" layoutY="80" />
        <Label style="-fx-font-size: 24px; -fx-opacity: 0.12; -fx-rotate: 15;" text="🐾" layoutX="200" layoutY="450" />
        <Label style="-fx-font-size: 35px; -fx-opacity: 0.10; -fx-rotate: 35;" text="🐾" layoutX="800" layoutY="100" />
        <Label style="-fx-font-size: 28px; -fx-opacity: 0.15; -fx-rotate: -10;" text="🐾" layoutX="750" layoutY="480" />
    </Pane>

    <VBox alignment="CENTER" maxWidth="580" maxHeight="480" spacing="22" 
          style="-fx-background-color: #FFFFFF; 
                 -fx-background-radius: 28; 
                 -fx-border-color: #F8E8EE; 
                 -fx-border-radius: 28; 
                 -fx-border-width: 2;
                 -fx-effect: dropshadow(three-pass-box, rgba(233, 30, 99, 0.06), 20, 0, 0, 8);">

        <padding>
            <Insets top="35" right="40" bottom="35" left="40" />
        </padding>

        <HBox alignment="CENTER" spacing="-15">

            <StackPane prefHeight="110" prefWidth="110" 
                       style="-fx-background-color: #FFF3E0; -fx-background-radius: 55; -fx-border-color: #FFFFFF; -fx-border-width: 4; -fx-border-radius: 55;">
                <Label style="-fx-font-size: 55px;" text="🐶" />
            </StackPane>
            
            <StackPane prefHeight="110" prefWidth="110" 
                       style="-fx-background-color: #FCE4EC; -fx-background-radius: 55; -fx-border-color: #FFFFFF; -fx-border-width: 4; -fx-border-radius: 55; -fx-translate-y: 20;">
                <Label style="-fx-font-size: 55px;" text="🐱" />
            </StackPane>
            
            <StackPane prefHeight="80" prefWidth="80" 
                       style="-fx-background-color: #E91E63; -fx-background-radius: 40; -fx-border-color: #FFFFFF; -fx-border-width: 4; -fx-border-radius: 40; -fx-translate-x: -15; -fx-translate-y: -25;">
                <Label style="-fx-font-size: 35px; -fx-text-fill: white;" text="❤" />
            </StackPane>
        </HBox>

        <VBox alignment="CENTER" spacing="8">
            <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Bem-Vinda(o) ao Sistema de Cadastro" />
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #E91E63;" text="SOPRAP • Sociedade Protetora dos Animais" />
        </VBox>

        <HBox alignment="CENTER" spacing="12">
            <StackPane style="-fx-background-color: #FFF8E7; -fx-background-radius: 15; -fx-padding: 6 14 6 14;">
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #D97706;" text="🐾 Resgates" />
            </StackPane>

            <StackPane style="-fx-background-color: #FDF2F8; -fx-background-radius: 15; -fx-padding: 6 14 6 14;">
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #DB2777;" text="🏡 Lares do Amor" />
            </StackPane>

            <StackPane style="-fx-background-color: #F0FDF4; -fx-background-radius: 15; -fx-padding: 6 14 6 14;">
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #16A34A;" text="✨ Finais Felizes" />
            </StackPane>
        </HBox>

        <Label alignment="CENTER" textAlignment="CENTER" wrapText="true" 
            style="-fx-font-size: 13px; -fx-text-fill: #718096; -fx-line-spacing: 3;" 
            text="Todo animal é uma vida: cuide com amor e respeito." />

    </VBox>

</StackPane>