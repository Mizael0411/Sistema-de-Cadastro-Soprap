<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-background-color: #FAFAFA; -fx-padding: 25;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abrigo.controller.SelecaoAnimalFichaController">

    <stylesheets>
        <URL value="@../../css/style.css" />
    </stylesheets>

    <!-- Cabeçalho com Ícone Bege, Título e Subtítulo (Estilo da imagem) -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <children>
            <!-- Caixinha Amarela/Bege arredondada com o emoji dentro -->
            <StackPane prefHeight="48.0" prefWidth="48.0" style="-fx-background-color: #FFF3E0; -fx-background-radius: 12; -fx-border-radius: 12;">
                <children>
                    <Label text="📋" style="-fx-font-size: 22px;" />
                </children>
            </StackPane>
            
            <!-- Título e Subtítulo -->
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <children>
                    <Label text="Ficha Técnica do Animal" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A202C;" />
                    <Label text="Selecione um animal para visualizar os detalhes." style="-fx-font-size: 13px; -fx-text-fill: #718096;" />
                </children>
            </VBox>
        </children>
    </HBox>

    <!-- Topo: Campo de Pesquisa e Botão de Ação -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <children>
            <!-- Campo de Busca Arredondado -->
            <TextField fx:id="txtBusca" promptText="🔍 Buscar por nome ou ID..." style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 8 16; -fx-font-size: 13px; -fx-prompt-text-fill: #A0AEC0;" HBox.hgrow="ALWAYS" />
            
            <!-- Botão Ver Ficha Técnica -->
            <Button onAction="#btnVerFichaOnAction" styleClass="btn-acao, btn-ficha-tecnica" text="Ver Ficha Técnica" />
        </children>
    </HBox>

    <VBox style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 10;" VBox.vgrow="ALWAYS">
        <children>
            <TableView fx:id="tabelaAnimais" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60.0" style="-fx-alignment: CENTER;" text="ID" />
                    <TableColumn fx:id="colNome" prefWidth="180.0" text="Nome" />                    
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </children>
    </VBox>

    <HBox alignment="CENTER_RIGHT">
        <children>
            <Button onAction="#btnVoltarOnAction" styleClass="btn-acao, btn-voltar" text="Voltar" />
        </children>
    </HBox>

</VBox>