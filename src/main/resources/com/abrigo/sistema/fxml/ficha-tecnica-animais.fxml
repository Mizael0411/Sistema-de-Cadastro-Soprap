<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" style="-fx-background-color: #FAF8F5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.abrigo.controller.FichaTecnicaAnimalController">

    <stylesheets>
        <URL value="@../../css/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12;">
        <StackPane prefHeight="50" prefWidth="50" style="-fx-background-color: #FFF3E0; -fx-background-radius: 12;">
            <Label style="-fx-font-size: 26px;" text="🐾" />
        </StackPane>

        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;" text="FICHA DO PET -" />
                <Label fx:id="lblNomeEId" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Carregando..." />
            </HBox>
        </VBox>

        <Label fx:id="lblBadgeStatus" style="-fx-background-color: #E3F2FD; -fx-text-fill: #1976D2; -fx-font-weight: bold; -fx-padding: 6 12; -fx-background-radius: 20; -fx-font-size: 13px;" text="Sem Estado" />
    </HBox>

    <HBox spacing="16">
        <VBox spacing="10" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="INFORMAÇÕES BÁSICAS" />
            <GridPane hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="90" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <Label style="-fx-text-fill: #7F8C8D;" text="Espécie:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="lblEspecie" style="-fx-font-weight: bold;" text="--" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label style="-fx-text-fill: #7F8C8D;" text="Porte:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="lblPorte" style="-fx-font-weight: bold;" text="--" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label style="-fx-text-fill: #7F8C8D;" text="Sexo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="lblSexo" style="-fx-font-weight: bold;" text="--" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label style="-fx-text-fill: #7F8C8D;" text="Idade:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <Label fx:id="lblIdade" style="-fx-font-weight: bold;" text="--" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label style="-fx-text-fill: #7F8C8D;" text="Gravidez:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <Label fx:id="lblGravidez" style="-fx-font-weight: bold;" text="--" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </GridPane>
        </VBox>

        <VBox spacing="10" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="SITUAÇÃO ATUAL" />
            <GridPane hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="110" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>
                <Label style="-fx-text-fill: #7F8C8D;" text="Hospedagem:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="lblHospedagem" style="-fx-font-weight: bold;" text="Abrigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label style="-fx-text-fill: #7F8C8D;" text="Voluntário Lar Temporário:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="lblVoluntarioLT" style="-fx-font-weight: bold;" text="--" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label style="-fx-text-fill: #7F8C8D;" text="Contato:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="lblContatoLT" style="-fx-font-weight: bold;" text="--" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label style="-fx-text-fill: #7F8C8D;" text="Status Adoção:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <Label fx:id="lblStatusAdocao" style="-fx-font-weight: bold; -fx-text-fill: #27AE60;" text="Disponível" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label style="-fx-text-fill: #7F8C8D;" text="Adotante:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <Label fx:id="lblAdotante" style="-fx-font-weight: bold;" text="--" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </GridPane>
        </VBox>
    </HBox>

    <VBox spacing="10" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E0E0E0; -fx-border-radius: 12; -fx-padding: 15;" VBox.vgrow="ALWAYS">
        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="HISTÓRICO DE VACINAS" />
        <TableView fx:id="tabelaVacinas" prefHeight="150" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colVacinaNome" prefWidth="200" text="Nome da Vacina" />
                <TableColumn fx:id="colVacinaData" prefWidth="150" text="Data Aplicação" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button onAction="#btnEditarPetOnAction" styleClass="btn-acao, btn-editar" text="Editar Pet" />
        <Button onAction="#btnVoltarOnAction" styleClass="btn-acao, btn-voltar" text="Voltar" />
    </HBox>

</VBox>