<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="ficha-scroll"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.abrigo.controller.FichaTecnicaAnimalController">

    <stylesheets>
        <URL value="@../../css/style.css"/>
    </stylesheets>

    <content>
        <VBox spacing="18" styleClass="ficha-pagina">
            <padding>
                <Insets top="24" right="26" bottom="24" left="26"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="16"
                  styleClass="ficha-cabecalho">

                <StackPane minWidth="62" minHeight="62"
                           prefWidth="62" prefHeight="62"
                           styleClass="ficha-icone">
                    <ImageView fitWidth="38" fitHeight="38"
                               preserveRatio="true">
                        <image>
                            <Image url="@../../images/pets.png"/>
                        </image>
                    </ImageView>
                </StackPane>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="SOPRAP  /  CUIDADO ANIMAL"
                           styleClass="ficha-sobretitulo"/>

                    <Label fx:id="lblNomeEId"
                           text="Carregando..."
                           wrapText="true"
                           styleClass="ficha-nome"/>

                    <Label text="Informações, acolhimento e acompanhamento"
                           styleClass="ficha-subtitulo"/>
                </VBox>

                <Label fx:id="lblBadgeStatus"
                       text="Carregando"
                       styleClass="ficha-status"/>
            </HBox>

            <VBox spacing="15" styleClass="ficha-card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="ficha-icone-pequeno">
                        <Label text="♥" styleClass="ficha-icone-texto"/>
                    </StackPane>
                    <VBox spacing="3">
                        <Label text="Sobre o animal"
                               styleClass="ficha-titulo-secao"/>
                        <Label text="Características e necessidades especiais"
                               styleClass="ficha-descricao-secao"/>
                    </VBox>
                </HBox>

                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"
                                           hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50"
                                           hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Espécie" styleClass="ficha-rotulo"/>
                        <Label fx:id="lblEspecie" text="--"
                               styleClass="ficha-valor"/>
                    </VBox>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Porte" styleClass="ficha-rotulo"/>
                        <Label fx:id="lblPorte" text="--"
                               styleClass="ficha-valor"/>
                    </VBox>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Sexo" styleClass="ficha-rotulo"/>
                        <Label fx:id="lblSexo" text="--"
                               styleClass="ficha-valor"/>
                    </VBox>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Idade" styleClass="ficha-rotulo"/>
                        <Label fx:id="lblIdade" text="--"
                               styleClass="ficha-valor"/>
                    </VBox>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Gravidez" styleClass="ficha-rotulo"/>
                        <Label fx:id="lblGravidez" text="--"
                               wrapText="true" styleClass="ficha-valor"/>
                    </VBox>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Possui deficiência?"
                               styleClass="ficha-rotulo"/>
                        <Label fx:id="lblPossuiDeficiencia" text="--"
                               styleClass="ficha-valor"/>
                    </VBox>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="0" GridPane.rowIndex="3"
                          GridPane.columnSpan="2">
                        <Label text="Descrição da deficiência"
                               styleClass="ficha-rotulo"/>
                        <Label fx:id="lblDescricaoDeficiencia"
                               text="--" wrapText="true"
                               styleClass="ficha-valor"/>
                    </VBox>
                </GridPane>
            </VBox>

            <VBox spacing="15" styleClass="ficha-card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="ficha-icone-pequeno">
                        <Label text="⌂" styleClass="ficha-icone-texto"/>
                    </StackPane>
                    <VBox spacing="3">
                        <Label text="Situação atual"
                               styleClass="ficha-titulo-secao"/>
                        <Label text="Onde está e quem acompanha o animal"
                               styleClass="ficha-descricao-secao"/>
                    </VBox>
                </HBox>

                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"
                                           hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50"
                                           hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Hospedagem" styleClass="ficha-rotulo"/>
                        <Label fx:id="lblHospedagem" text="Abrigo"
                               wrapText="true" styleClass="ficha-valor"/>
                    </VBox>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label fx:id="lblRotuloResponsavel"
                               text="Responsável:"
                               wrapText="true" styleClass="ficha-rotulo"/>
                        <Label fx:id="lblVoluntarioLT" text="--"
                               wrapText="true" styleClass="ficha-valor"/>
                    </VBox>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Contato" styleClass="ficha-rotulo"/>
                        <Label fx:id="lblContatoLT" text="--"
                               wrapText="true" styleClass="ficha-valor"/>
                    </VBox>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Status da adoção"
                               styleClass="ficha-rotulo"/>
                        <Label fx:id="lblStatusAdocao"
                               text="Disponível" wrapText="true"
                               styleClass="ficha-valor-destaque"/>
                    </VBox>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Adotante" styleClass="ficha-rotulo"/>
                        <Label fx:id="lblAdotante" text="--"
                               wrapText="true" styleClass="ficha-valor"/>
                    </VBox>

                    <VBox spacing="5" styleClass="ficha-campo"
                          GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Data da adoção"
                               styleClass="ficha-rotulo"/>
                        <Label fx:id="lblDataAdocao" text="--"
                               styleClass="ficha-valor"/>
                    </VBox>
                </GridPane>
            </VBox>

            <VBox spacing="15" styleClass="ficha-card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <StackPane styleClass="ficha-icone-pequeno">
                        <Label text="✚" styleClass="ficha-icone-texto"/>
                    </StackPane>
                    <VBox spacing="3">
                        <Label text="Saúde e vacinação"
                               styleClass="ficha-titulo-secao"/>
                        <Label text="Histórico de aplicações e próximas doses"
                               styleClass="ficha-descricao-secao"/>
                    </VBox>
                </HBox>

                <TableView fx:id="tabelaVacinas"
                           prefHeight="190"
                           minHeight="130"
                           styleClass="ficha-tabela"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colVacinaNome"
                                     text="Vacina"
                                     prefWidth="180"/>
                        <TableColumn fx:id="colVacinaDose"
                                     text="Dose"
                                     prefWidth="100"/>
                        <TableColumn fx:id="colVacinaData"
                                     text="Data da aplicação"
                                     prefWidth="150"/>
                        <TableColumn fx:id="colProximaVacina"
                                     text="Próxima vacinação"
                                     prefWidth="170"/>
                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button text="Voltar"
                        onAction="#btnVoltarOnAction"
                        styleClass="btn-acao, btn-voltar"/>

                <Button text="Editar animal"
                        onAction="#btnEditarPetOnAction"
                        styleClass="btn-acao, btn-editar"/>
            </HBox>

        </VBox>
    </content>
</ScrollPane>
