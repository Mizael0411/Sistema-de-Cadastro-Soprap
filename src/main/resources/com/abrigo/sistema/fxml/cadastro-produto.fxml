<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            styleClass="cadastro-scroll"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.abrigo.controller.CadastroProdutoController">

    <stylesheets>
        <URL value="@../../css/style.css"/>
    </stylesheets>

    <content>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              styleClass="cadastro-pagina">

            <padding>
                <Insets top="30" right="20" bottom="40" left="20"/>
            </padding>

            <VBox maxWidth="780"
                  spacing="24"
                  styleClass="cadastro-card">

                <padding>
                    <Insets top="32" right="34" bottom="30" left="34"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="16">

                    <StackPane prefWidth="56"
                               prefHeight="56"
                               minWidth="56"
                               styleClass="cadastro-icone">

                        <ImageView fitWidth="34"
                                   fitHeight="34"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../../images/produto.png"/>
                            </image>
                        </ImageView>
                    </StackPane>

                    <VBox spacing="5" HBox.hgrow="ALWAYS">

                        <Label text="SOPRAP  ·  CONTROLE DE ESTOQUE"
                               styleClass="cadastro-sobretitulo"/>

                        <Label text="Cadastro de Produto"
                               styleClass="cadastro-titulo"
                               wrapText="true"/>

                        <Label text="Registre os produtos e insumos adquiridos para atender às necessidades do abrigo."
                               styleClass="cadastro-subtitulo"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <Separator styleClass="cadastro-separador"/>

                <VBox spacing="5">
                    <Label text="01  ·  Informações do produto"
                           styleClass="cadastro-secao-titulo"/>

                    <Label text="Identifique o produto e informe seu preço de compra."
                           styleClass="cadastro-secao-subtitulo"/>
                </VBox>

                <GridPane hgap="18" vgap="17">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="7"
                          GridPane.columnIndex="0"
                          GridPane.columnSpan="2"
                          GridPane.rowIndex="0">

                        <Label text="NOME DO PRODUTO *"
                               styleClass="cadastro-rotulo"/>

                        <TextField fx:id="txtNome"
                                   maxWidth="Infinity"
                                   promptText="Ex.: Ração Golden Adultos 15 kg"
                                   styleClass="input-campo"/>
                    </VBox>

                    <VBox spacing="7"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1">

                        <Label text="PREÇO DE COMPRA (R$) *"
                               styleClass="cadastro-rotulo"/>

                        <TextField fx:id="txtPrecoCompra"
                                   maxWidth="Infinity"
                                   promptText="Ex.: 149,90"
                                   styleClass="input-campo"/>
                    </VBox>

                    <VBox spacing="7"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1">

                        <Label text="DATA DA COMPRA *"
                               styleClass="cadastro-rotulo"/>

                        <DatePicker fx:id="dpDataCompra"
                                    maxWidth="Infinity"
                                    promptText="Selecione a data"
                                    styleClass="input-campo"/>
                    </VBox>
                </GridPane>

                <Separator styleClass="cadastro-separador"/>

                <VBox spacing="5">
                    <Label text="02  ·  Validade do produto"
                           styleClass="cadastro-secao-titulo"/>

                    <Label text="Informe a data de validade quando o produto possuir essa informação."
                           styleClass="cadastro-secao-subtitulo"
                           wrapText="true"/>
                </VBox>

                <VBox spacing="7">

                    <Label text="DATA DE VALIDADE"
                           styleClass="cadastro-rotulo"/>

                    <DatePicker fx:id="dpDataValidade"
                                maxWidth="Infinity"
                                promptText="Selecione a validade, se houver"
                                styleClass="input-campo"/>
                </VBox>

                <Separator styleClass="cadastro-separador"/>

                <HBox alignment="CENTER_RIGHT"
                      spacing="10">

                    <padding>
                        <Insets top="5"/>
                    </padding>

                    <Button fx:id="btnLimpar"
                            onAction="#btnLimparOnAction"
                            styleClass="btn-acao, btn-voltar"
                            text="Limpar campos"/>

                    <Button fx:id="btnVerHistorico"
                            onAction="#verHistorico"
                            styleClass="btn-acao, btn-historico"
                            text="Ver histórico"/>

                    <Button fx:id="btnSalvar"
                            onAction="#btnSalvarOnAction"
                            styleClass="btn-acao, btn-novo"
                            text="Salvar produto"/>
                </HBox>
                
            </VBox>
        </VBox>
    </content>
</ScrollPane>
