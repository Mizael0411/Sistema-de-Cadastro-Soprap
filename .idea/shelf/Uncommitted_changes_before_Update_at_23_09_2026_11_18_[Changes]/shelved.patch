<+>/* ==========================================================================\r\n   1. MENU LATERAL (Corrigido)\r\n   ========================================================================== */\r\n\r\n/* Estado Base */\r\n.menu-btn {\r\n    -fx-background-color: #FFFFFF;\r\n    -fx-text-fill: #2C3E50;\r\n    -fx-font-size: 13px;\r\n    -fx-font-weight: normal;\r\n    -fx-background-radius: 8px;\r\n    -fx-border-color: #F1E5D1;\r\n    -fx-border-radius: 8px;\r\n    -fx-border-width: 1px;\r\n    -fx-padding: 10px 14px;\r\n    -fx-cursor: hand;\r\n    -fx-alignment: CENTER-LEFT;\r\n}\r\n\r\n/* Transição de Hover (ao passar o mouse) */\r\n.menu-btn:hover {\r\n    -fx-background-color: #FFF9F0;\r\n    -fx-border-color: #E2D3BC;\r\n    -fx-text-fill: #1E293B;\r\n}\r\n\r\n/* Estado Ativo (Botão Selecionado no Menu) */\r\n.menu-btn.active {\r\n    -fx-background-color: #FFF3E0;\r\n    -fx-text-fill: #2C3E50;\r\n    -fx-font-weight: bold;\r\n    -fx-border-color: #E91E63;\r\n    -fx-border-width: 0 0 0 4px; /* Mantém o destaque lateral apenas quando ativo */\r\n}\r\n\r\n\r\n/* ==========================================================================\r\n   2. BOTÕES DE AÇÃO DAS TABELAS E FORMULÁRIOS\r\n   ========================================================================== */\r\n\r\n/* Regra Geral para Botões de Ação */\r\n.btn-acao {\r\n    -fx-min-height: 38px;\r\n    -fx-pref-height: 38px;\r\n    -fx-font-size: 13px;\r\n    -fx-font-weight: bold;\r\n    -fx-background-radius: 10px;\r\n    -fx-border-radius: 10px;\r\n    -fx-border-width: 1px;\r\n    -fx-cursor: hand;\r\n    -fx-alignment: CENTER;\r\n}\r\n\r\n/* Botão Voltar (Neutro) */\r\n.btn-voltar {\r\n    -fx-background-color: #F8FAFC;\r\n    -fx-text-fill: #475569;\r\n    -fx-border-color: #E2E8F0;\r\n    -fx-padding: 0 18px;\r\n}\r\n.btn-voltar:hover {\r\n    -fx-background-color: #E2E8F0;\r\n    -fx-text-fill: #1E293B;\r\n    -fx-border-color: #CBD5E1;\r\n}\r\n\r\n/* Botão Excluir (Alerta) */\r\n.btn-excluir {\r\n    -fx-background-color: #FFEBEE;\r\n    -fx-text-fill: #C62828;\r\n    -fx-border-color: #FFCDD2;\r\n    -fx-padding: 0 18px;\r\n}\r\n.btn-excluir:hover {\r\n    -fx-background-color: #FFCDD2;\r\n    -fx-text-fill: #B71C1C;\r\n    -fx-border-color: #EF9A9A;\r\n}\r\n\r\n/* Botão Editar (Ação Secundária) */\r\n.btn-editar {\r\n    -fx-background-color: #EEF2FF;\r\n    -fx-text-fill: #4F46E5;\r\n    -fx-border-color: #C7D2FE;\r\n    -fx-padding: 0 18px;\r\n}\r\n.btn-editar:hover {\r\n    -fx-background-color: #C7D2FE;\r\n    -fx-text-fill: #3730A3;\r\n    -fx-border-color: #A5B4FC;\r\n}\r\n\r\n/* Botão + Novo (Destaque/CTA) */\r\n.btn-novo, .btn-salvar {\r\n    -fx-background-color: #FCE4EC;\r\n    -fx-text-fill: #C2185B;\r\n    -fx-border-color: #F8BBD0;\r\n    -fx-padding: 0 22px;\r\n    -fx-effect: dropshadow(three-pass-box, rgba(233, 30, 99, 0.15), 6, 0, 0, 2);\r\n}\r\n.btn-novo:hover, .btn-salvar:hover {\r\n    -fx-background-color: #F8BBD0;\r\n    -fx-text-fill: #880E4F;\r\n    -fx-border-color: #F48FB1;\r\n    -fx-effect: dropshadow(three-pass-box, rgba(233, 30, 99, 0.3), 8, 0, 0, 3);\r\n}\r\n\r\n/* Botão Ver Histórico / Pesquisar */\r\n.btn-historico {\r\n    -fx-background-color: #E0F2FE;\r\n    -fx-text-fill: #0369A1;\r\n    -fx-border-color: #BAE6FD;\r\n    -fx-padding: 0 18px;\r\n}\r\n.btn-historico:hover {\r\n    -fx-background-color: #BAE6FD;\r\n    -fx-text-fill: #0284C7;\r\n    -fx-border-color: #7DD3FC;\r\n}\r\n\r\n\r\n.menu-card {\r\n    -fx-background-color: #FFFFFF;\r\n    -fx-background-radius: 16;\r\n    -fx-border-color: #F1E5D1;\r\n    -fx-border-radius: 16;\r\n    -fx-border-width: 1.5;\r\n    -fx-padding: 22 28 22 28;\r\n    -fx-pref-width: 520;\r\n    -fx-min-width: 380;\r\n    -fx-cursor: hand;\r\n}\r\n\r\n\r\n.menu-card:hover {\r\n    -fx-border-color: #F8BBD0;\r\n    -fx-background-color: #FFFDFB;\r\n}\r\n\r\n.menu-card-titulo {\r\n    -fx-font-size: 15px;\r\n    -fx-font-weight: bold;\r\n    -fx-text-fill: #2C3E50;\r\n    -fx-letter-spacing: 0.5px;\r\n}\r\n\r\n.menu-card-sub {\r\n    -fx-font-size: 12px;\r\n    -fx-text-fill: #7F8C8D;\r\n}
